{
  "source": "guuey#2385, spec §12: the form, select and watcher examples. The watcher is the @json-render/core@0.21.1 README's State Watchers element, verbatim, as the root. The core README carries no form or select spec, so those two are written in the shape of the package's published types (Spec, UIElement, ActionBinding, ValidationCheck, PropExpression), read at 0.21.1. The package is not a dependency, so none of these were run through it.",
  "cases": [
    {
      "name": "form",
      "row": "README: a contact form",
      "carrier": { "title": "Contact us" },
      "spec": {
        "root": "form",
        "elements": {
          "form": {
            "type": "Form",
            "props": {},
            "children": ["heading", "name", "email", "message", "send"]
          },
          "heading": { "type": "Heading", "props": { "text": "Contact us", "level": 2 } },
          "name": {
            "type": "Input",
            "props": {
              "label": "Name",
              "value": { "$bindState": "/form/name" },
              "checks": [{ "type": "required" }]
            }
          },
          "email": {
            "type": "Input",
            "props": {
              "label": "Email",
              "type": "email",
              "value": { "$bindState": "/form/email" },
              "checks": [{ "type": "required" }, { "type": "email" }]
            }
          },
          "message": {
            "type": "Textarea",
            "props": {
              "label": "Message",
              "value": { "$bindState": "/form/message" },
              "checks": [{ "type": "maxLength", "args": { "max": 500 } }]
            }
          },
          "send": {
            "type": "Button",
            "props": { "label": "Send", "variant": "primary" },
            "on": {
              "press": {
                "action": "submit_contact",
                "params": {
                  "name": { "$state": "/form/name" },
                  "email": { "$state": "/form/email" },
                  "message": { "$state": "/form/message" }
                }
              }
            }
          }
        },
        "state": { "form": { "name": "", "email": "", "message": "" } }
      }
    },
    {
      "name": "select",
      "row": "README: a select with a dependent summary",
      "spec": {
        "root": "page",
        "elements": {
          "page": {
            "type": "Stack",
            "props": { "gap": "md" },
            "children": ["plan", "summary", "go"]
          },
          "plan": {
            "type": "Select",
            "props": {
              "label": "Plan",
              "options": [
                { "label": "Free", "value": "free" },
                { "label": "Team", "value": "team" },
                { "label": "Enterprise", "value": "enterprise" }
              ],
              "value": { "$bindState": "/plan" }
            }
          },
          "summary": {
            "type": "Text",
            "props": { "text": { "$template": "Current plan: ${/plan}" } }
          },
          "go": {
            "type": "Button",
            "props": { "label": "Continue" },
            "on": {
              "press": { "action": "choose_plan", "params": { "plan": { "$state": "/plan" } } }
            }
          }
        },
        "state": { "plan": "team" }
      }
    },
    {
      "name": "watcher",
      "row": "README: a watcher that loads cities for a country",
      "spec": {
        "root": "country",
        "elements": {
          "country": {
            "type": "Select",
            "props": {
              "label": "Country",
              "value": { "$bindState": "/form/country" },
              "options": ["US", "Canada", "UK"]
            },
            "watch": {
              "/form/country": {
                "action": "loadCities",
                "params": { "country": { "$state": "/form/country" } }
              }
            },
            "children": []
          }
        },
        "state": { "form": { "country": "" } }
      }
    }
  ]
}

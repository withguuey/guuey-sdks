{
  "source": "@guuey/worker listCredentials (oss/packages/worker/src/creds.ts)",
  "cases": [
    {
      "name": "two valid entries, keyed by the entry's name",
      "serversFile": {
        "kind": "file",
        "node": {
          "kind": "text",
          "text": "{\"version\":1,\"servers\":[{\"name\":\"myMcp\",\"credential\":{\"url\":\"https://relay.example/_executor/mcp/abc\",\"transport\":\"http\",\"headers\":{\"authorization\":\"Bearer cap\"}}},{\"name\":\"Linear Tools\",\"credential\":{\"url\":\"https://b.example/mcp\",\"transport\":\"sse\",\"headers\":{},\"expiresAt\":\"2026-01-01T00:00:00.000Z\"}}]}"
        }
      },
      "session": {
        "kind": "absent"
      },
      "env": {},
      "expected": [
        {
          "name": "myMcp",
          "cred": {
            "url": "https://relay.example/_executor/mcp/abc",
            "transport": "http",
            "headers": {
              "authorization": "Bearer cap"
            }
          }
        },
        {
          "name": "Linear Tools",
          "cred": {
            "url": "https://b.example/mcp",
            "transport": "sse",
            "headers": {},
            "expiresAt": "2026-01-01T00:00:00.000Z"
          }
        }
      ]
    },

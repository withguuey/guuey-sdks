[
  {
    "name": "text",
    "calls": [
      {
        "method": "text",
        "text": "hello"
      }
    ],
    "expected": "{\"type\":\"text\",\"text\":\"hello\"}\n"
  },
  {
    "name": "text: empty",
    "calls": [
      {
        "method": "text",
        "text": ""
      }
    ],
    "expected": "{\"type\":\"text\",\"text\":\"\"}\n"
  },
  {
    "name": "text: JSON escapes",
    "calls": [
      {
        "method": "text",
        "text": "q\" b\\ s/ nl\n cr\r tab\t bs\b ff\f nul\u0000 us\u001f vt\u000b"
      }
    ],
    "expected": "{\"type\":\"text\",\"text\":\"q\\\" b\\\\ s/ nl\\n cr\\r tab\\t bs\\b ff\\f nul\\u0000 us\\u001f vt\\u000b\"}\n"
  },
  {
    "name": "text: characters written literally",
    "calls": [
      {
        "method": "text",
        "text": "del nel nbsp  é ls  ps  bom﻿ 中 😀"
      }
    ],
    "expected": "{\"type\":\"text\",\"text\":\"del nel nbsp  é ls  ps  bom﻿ 中 😀\"}\n"
  },
  {
    "name": "text: lone high surrogate",
    "calls": [
      {
        "method": "text",
        "text": "a\ud800b"
      }
    ],
    "expected": "{\"type\":\"text\",\"text\":\"a\\ud800b\"}\n"
  },
  {
    "name": "text: lone low surrogate",
    "calls": [
      {
        "method": "text",
        "text": "\udc00"
      }
    ],
    "expected": "{\"type\":\"text\",\"text\":\"\\udc00\"}\n"
  },
  {
    "name": "text: surrogates in reverse order",
    "calls": [
      {
        "method": "text",
        "text": "\udc00\ud800"
      }
    ],
    "expected": "{\"type\":\"text\",\"text\":\"\\udc00\\ud800\"}\n"
  },
  {
    "name": "text: a high surrogate at the end",
    "calls": [
      {
        "method": "text",
        "text": "x\udbff"
      }
    ],
    "expected": "{\"type\":\"text\",\"text\":\"x\\udbff\"}\n"
  },
  {
    "name": "done: default stopReason",
    "calls": [
      {
        "method": "done",
        "result": "final"
      }
    ],
    "expected": "{\"type\":\"done\",\"stopReason\":\"end_turn\",\"result\":\"final\"}\n"
  },
  {
    "name": "done: max_turns",
    "calls": [
      {
        "method": "done",
        "result": "r",
        "stopReason": "max_turns"
      }
    ],
    "expected": "{\"type\":\"done\",\"stopReason\":\"max_turns\",\"result\":\"r\"}\n"
  },
  {
    "name": "done: error",
    "calls": [
      {
        "method": "done",
        "result": "",
        "stopReason": "error"
      }
    ],
    "expected": "{\"type\":\"done\",\"stopReason\":\"error\",\"result\":\"\"}\n"
  },
  {
    "name": "done: endThread",
    "calls": [
      {
        "method": "done",
        "result": "This chat is full.",
        "stopReason": "end_turn",
        "endThread": {
          "code": "CHAT_FULL",
          "message": "This chat is full."
        }
      }
    ],
    "expected": "{\"type\":\"done\",\"stopReason\":\"end_turn\",\"result\":\"This chat is full.\",\"endThread\":{\"code\":\"CHAT_FULL\",\"message\":\"This chat is full.\"}}\n"
  },
  {
    "name": "done: endThread with the default stopReason",
    "calls": [
      {
        "method": "done",
        "result": "r",
        "endThread": {
          "code": "X",
          "message": "bye 👋"
        }
      }
    ],
    "expected": "{\"type\":\"done\",\"stopReason\":\"end_turn\",\"result\":\"r\",\"endThread\":{\"code\":\"X\",\"message\":\"bye 👋\"}}\n"
  },
  {
    "name": "done: endThread is written as given, not validated",
    "calls": [
      {
        "method": "done",
        "result": "r",
        "endThread": {
          "code": "lower",
          "message": ""
        }
      }
    ],
    "expected": "{\"type\":\"done\",\"stopReason\":\"end_turn\",\"result\":\"r\",\"endThread\":{\"code\":\"lower\",\"message\":\"\"}}\n"
  },
  {
    "name": "error",
    "calls": [
      {
        "method": "error",
        "message": "boom"
      }
    ],
    "expected": "{\"type\":\"error\",\"message\":\"boom\"}\n"
  },
  {
    "name": "native: object",
    "calls": [
      {
        "method": "native",
        "framework": "claude-agent-sdk",

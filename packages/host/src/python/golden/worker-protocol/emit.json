  },
  {
    "name": "native: JavaScript key order",
    "calls": [
      {
        "method": "native",
        "framework": "f",
        "event": {
          "2": 3,
          "10": 2,
          "4294967294": 5,
          "b": 1,
          "a": {
            "0": 2,
            "1": 0,
            "z": 1
          },
          "4294967295": 4,
          "01": 6
        }
      }
    ],
    "expected": "{\"type\":\"native\",\"framework\":\"f\",\"event\":{\"2\":3,\"10\":2,\"4294967294\":5,\"b\":1,\"a\":{\"0\":2,\"1\":0,\"z\":1},\"4294967295\":4,\"01\":6}}\n"
  },

{
  "name": "@guuey/cli",
  "version": "0.3.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "CLI tool for the guuey platform",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "guuey": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "rm -rf dist && pnpm build",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@guuey/state": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@ggui-ai/artifact-manifest": "0.6.3",
    "@ggui-ai/protocol": "0.6.3",
    "@guuey/config": "workspace:*",
    "@guuey/create-agentic-app": "workspace:*",
    "@guuey/host": "workspace:*",
    "@guuey/worker": "workspace:*",
    "@silverprotocol/claude-agent-sdk": "0.4.1",
    "@silverprotocol/core": "0.4.1",
    "@silverprotocol/google-adk": "0.4.1",
    "@silverprotocol/openai-agents": "0.4.1",
    "esbuild": "^0.25.12",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.0",
    "yaml": "^2.8.2"
  },
  "homepage": "https://guuey.com",
  "bugs": {
    "url": "https://github.com/loqu-co/guuey/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withguuey/guuey-sdks.git",
    "directory": "packages/cli"
  }
}
